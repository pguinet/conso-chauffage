# Configuration de l'application de suivi de chaudière

# Station météo (par défaut: Le Bourget)
# Les données sont récupérées via Open-Meteo API (gratuit, sans clé)
METEO_STATION=Le Bourget

# Température de base pour calcul DJU (par défaut: 18.0°C)
DJU_BASE_TEMP=18.0

# Configuration Flask (optionnel)
FLASK_ENV=development
FLASK_DEBUG=True
